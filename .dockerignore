# IDE and editor files
.idea/
.vscode/
*.swp
*~
.devcontainer/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/

# Generated local data and DB files that should not be in the image
*.db
*.sqlite3
data/eido_sentinel_local.db
data/geocoded_locations.json

# Stack dumps and build artifacts
bash.exe.stackdump
build/
dist/
*.egg-info/