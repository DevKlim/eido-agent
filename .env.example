# ---------------------------------------------------------------
# EIDO Sentinel Environment Variables (.env.example)
# Copy this file to .env and fill in your values for LOCAL development.
# For deployment, these variables must be set in your hosting provider's environment variables/secrets section.
# Lines starting with # are comments.
# ---------------------------------------------------------------

# --- Application Settings ---
# Base URL for the FastAPI backend. Used by the Streamlit UI.
# 
# LOCAL DEVELOPMENT:
# The Streamlit UI (frontend) needs to know the address of the FastAPI (backend).
# This should match the API_HOST and API_PORT below.
# Example for local dev: API_BASE_URL="http://localhost:8000"
#
# DEPLOYMENT (IMPORTANT!):
# When you deploy the backend (e.g., to Render), it will get a public URL like "https://your-backend-app.onrender.com".
# You MUST update this value to that public URL in your frontend's environment (e.g., Streamlit Cloud secrets).
API_BASE_URL="http://localhost:8000"

# --- Database (for Backend) ---
# Connection string for your PostgreSQL database.
#
# LOCAL DEVELOPMENT:
# For simple local development, a file-based SQLite database is recommended.
# This requires no setup. The file will be created automatically in a 'data' directory.
DATABASE_URL="sqlite+aiosqlite:///./data/eido_sentinel_local.db"
#
# To use PostgreSQL locally (e.g., with Docker), comment out the SQLite line above and uncomment this one.
# Ensure your PostgreSQL server is running with the correct user, password, and database name.
# Example for local Docker: DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/eido_sentinel_db"
#
# DEPLOYMENT:
# On Render, this will be provided by the PostgreSQL service (use the "Internal Connection String").
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/eido_sentinel_db"

# --- Logging (for Backend) ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- LLM Configuration (for Backend) ---
# Select the main LLM provider: 'google', 'openrouter', 'local', 'none'
LLM_PROVIDER="google"

# --- Google Generative AI (for Backend) ---
# Required if LLM_PROVIDER=google
GOOGLE_API_KEY=""
# Optional: Specify model. "gemini-1.5-flash" is a capable and cost-effective model.
GOOGLE_MODEL_NAME="gemini-2.5-flash-05-20"

# --- OpenRouter (for Backend) ---
# Required if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_NAME="openai/gpt-4o-mini"
OPENROUTER_API_BASE_URL="https://openrouter.ai/api/v1"

# --- Local LLM (Ollama, etc. via OpenAI compatible API) (for Backend) ---
# Required if LLM_PROVIDER=local
LOCAL_LLM_API_BASE_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL_NAME="llama3:latest"
LOCAL_LLM_API_KEY="ollama"

# --- Embedding Service (for Backend) ---
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# --- Geocoding Service (for Backend) ---
# REQUIRED: Set a unique User-Agent including contact info (email) per Nominatim's policy.
# This is critical for not getting blocked by the free OpenStreetMap/Nominatim service.
GEOCODING_USER_AGENT="EidoSentinelApp/0.9.1 (contact: your_email@example.com)" # CHANGE THIS

# --- Incident Matching Parameters (for Backend) ---
SIMILARITY_THRESHOLD=0.70
TIME_WINDOW_MINUTES=60
DISTANCE_THRESHOLD_KM=1.0

# --- API Server Configuration (Local Development) ---
# These are used by `run_all.sh` to start the local backend server.
# On Render, HOST is set to 0.0.0.0 and PORT is set by Render ($PORT).
API_HOST="127.0.0.1"
API_PORT=8000

# --- Streamlit UI Port (Local Development) ---
# `run_all.sh` uses this to start the local Streamlit server.
STREAMLIT_SERVER_PORT=8501

# --- Streamlit UI Auto Shutdown (Local Development) ---
# Automatically terminate Streamlit if no browser is connected for this duration (in seconds).
# Set to 0 to disable.
STREAMLIT_AUTO_SHUTDOWN_DELAY=0

# ---------------------------------------------------------------
# DEPLOYMENT NOTES
# ---------------------------------------------------------------
#
# == Backend (e.g., Render) ==
# You will set most of the variables above (DATABASE_URL, GOOGLE_API_KEY, etc.)
# as Environment Variables in your Render service settings.
# Render will set PORT and HOST for you.
#
# == Frontend (e.g., Streamlit Cloud) ==
# You will set secrets in your Streamlit Cloud app settings.
# The most important secret is API_BASE_URL.
#
# Example Streamlit Cloud secrets (`secrets.toml` format):
#
# API_BASE_URL = "https://your-backend-app-name.onrender.com"
#
# The UI code in `ui/app.py` is designed to read this secret automatically when deployed.
#